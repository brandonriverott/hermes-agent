+# The evidence gate is deployed BESIDE this script, never inside the worktree.
+# A builder holds Write and Bash over everything under $job_dir/wt, so a gate
+# that lived there would be a gate the candidate could edit. Source of truth is
+# scripts/jobs_evidence_gate.py in hermes-agent; it deploys here with this file
+# and under the same byte-identical Mac/PC rule.
+GATE="${JOBS_GATE:-$HOME/.local/bin/jobs_evidence_gate.py}"
+
+# Bind one receipt to this job, this attempt, and the commit that is actually
+# checked out now. HEAD is read AFTER the seat has run: VULCAN and THEMIS both
+# hold Bash, so either can move it, and evidence gathered at a commit that is
+# not the candidate must never settle the candidate.
+gate_stamp() { # gate_stamp <receipt> <tests|review> <attempt>
+  python3 "$GATE" stamp --file "$1" --kind "$2" --job "$key" \
+    --attempt "$3" --commit "$(git rev-parse HEAD 2>/dev/null)" --base "$BASE"
+}
+
 mode="${1:-}"; key="${2:-}"

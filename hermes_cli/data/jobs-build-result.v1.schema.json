{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jobs builder and test result (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "failure_class", "reason", "tests", "critical_user_journey", "handoff"],
  "properties": {
    "outcome": {"type": "string", "enum": ["succeeded", "failed"]},
    "failure_class": {
      "type": ["string", "null"],
      "enum": [null, "implementation", "infrastructure", "timeout", "safety", "cancelled"]
    },
    "reason": {"type": ["string", "null"], "maxLength": 512},
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cmd", "result", "evidence", "classification", "note"],
        "properties": {
          "cmd": {"type": "string", "minLength": 1, "maxLength": 512},
          "result": {"type": "string", "enum": ["pass", "fail", "flaky"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 1024},
          "classification": {
            "type": ["string", "null"],
            "enum": [null, "candidate_regression", "pre_existing", "infrastructure", "prerequisite_unavailable"]
          },
          "note": {"type": ["string", "null"], "maxLength": 1024}
        }
      }
    },
    "critical_user_journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "result", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "result": {"type": "string", "enum": ["pass", "fail", "not_applicable"]},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "next_action"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 700},
        "next_action": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}

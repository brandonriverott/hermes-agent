{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jobs independent review result (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings", "checks_run", "handoff"],
  "properties": {
    "verdict": {"type": "string", "enum": ["PASS", "NEEDS_CHANGES", "UNABLE_TO_VERIFY"]},
    "findings": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "checks_run": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "next_action"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 700},
        "next_action": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}

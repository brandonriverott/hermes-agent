{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jobs independent review result (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "finding_type", "findings", "checks_run", "handoff", "outcome_evidence", "knowledge_closure"],
  "properties": {
    "verdict": {"type": "string", "enum": ["PASS", "NEEDS_CHANGES", "UNABLE_TO_VERIFY"]},
    "finding_type": {"type": "string", "enum": ["none", "defect", "missing_evidence"]},
    "findings": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "checks_run": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "next_action"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 700},
        "next_action": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "outcome_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_user_journey", "verdict", "environment", "checks_run", "observed_behavior", "artifact_digests", "observed_at"],
      "properties": {
        "critical_user_journey": {"type": "string", "minLength": 1, "maxLength": 4096},
        "verdict": {"type": "string", "enum": ["PASS", "FAIL", "UNABLE_TO_VERIFY"]},
        "environment": {"type": "string", "minLength": 1, "maxLength": 4096},
        "checks_run": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "observed_behavior": {"type": "string", "minLength": 1, "maxLength": 4096},
        "artifact_digests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "observed_at": {"type": "integer", "minimum": 0}
      }
    },
    "knowledge_closure": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition", "canonical_note_path", "retrieval_confirmed", "steward_receipt_digest", "rationale"],
          "properties": {
            "disposition": {"type": "string", "enum": ["ACCEPTED", "REJECTED", "NOT_APPLICABLE"]},
            "canonical_note_path": {"type": ["string", "null"], "maxLength": 4096},
            "retrieval_confirmed": {"type": "boolean"},
            "steward_receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "rationale": {"type": ["string", "null"], "maxLength": 4096}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "PASS"}}},
      "then": {
        "properties": {
          "finding_type": {"const": "none"},
          "findings": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "NEEDS_CHANGES"}}},
      "then": {
        "properties": {
          "finding_type": {"const": "defect"},
          "findings": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "UNABLE_TO_VERIFY"}}},
      "then": {
        "properties": {
          "finding_type": {"const": "missing_evidence"},
          "findings": {"minItems": 1}
        }
      }
    }
  ]
}
